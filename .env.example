DATABASE_URL="mysql://root:CHANGE_ME@127.0.0.1:3306/hspsi-dev"
REDIS_URL="redis://127.0.0.1:6379/10"
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
JWT_ACCESS_TTL="30d"
SESSION_TTL_SECONDS="2592000"
BOOTSTRAP_ADMIN_PASSWORD="set-only-when-running-bootstrap"
API_PORT="8000"
WEB_ORIGIN="http://127.0.0.1:5173"

# 外部系统对接
# 薪福通 OA（凭证走数据库 hspsi_sys_account_set，这里配置服务地址与可选参数）
XINFUTONG_OA_BASE_URL="https://api.cmbchina.com"
# 是否为加密应用（加密应用需对 body 进行 SM4 加解密，默认 true）
XINFUTONG_OA_ENCRYPTED="true"
# 企业号（可选，不传则默认取应用所属企业）
XINFUTONG_OA_CSC_PRJ_COD=""
# 薪福通企业用户号（可选，定时任务可填 A0001）
XINFUTONG_OA_CSC_USR_NBR=""
# 薪福通平台用户号（可选，定时任务可填 AUTO0001）
XINFUTONG_OA_CSC_USR_UID=""

# 十方清源（凭证走 .env）
SHIFANG_QINGYUAN_BASE_URL="https://xxx"
SHIFANG_QINGYUAN_PUBLIC_KEY=""
SHIFANG_QINGYUAN_PRIVATE_KEY=""

# 华溯之家（凭证走 .env）
HUASU_HOME_BASE_URL="https://xxx"
HUASU_HOME_APP_PUBLIC_KEY=""

# 阿里云 OSS（Bucket 应设置为私有）
OSS_REGION="oss-cn-shanghai"
OSS_BUCKET="replace-with-private-bucket"
OSS_ACCESS_KEY_ID="replace-with-ram-access-key-id"
OSS_ACCESS_KEY_SECRET="replace-with-ram-access-key-secret"
# 使用 RAM Role/STS 时可配置；长期 AccessKey 模式留空
OSS_STS_TOKEN=""
# 可选：自定义域名，仅填写域名，不带协议
OSS_CNAME=""
OSS_UPLOAD_URL_TTL_SECONDS="900"
OSS_DOWNLOAD_URL_TTL_SECONDS="600"
OSS_ATTACHMENT_MAX_SIZE_MB="20"
OSS_ATTACHMENT_MAX_COUNT="10"
# 逗号分隔；扩展名可带或不带点，MIME必须与扩展名匹配
OSS_ALLOWED_EXTENSIONS="pdf,jpg,jpeg,png,webp,txt,doc,docx,xls,xlsx"
OSS_ALLOWED_MIME_TYPES="application/pdf,image/jpeg,image/png,image/webp,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
# 孤儿对象至少保留该小时数后才允许清理
OSS_ORPHAN_RETENTION_HOURS="24"

# 华数之家等外部商户推送售后申请的共享令牌（建议至少32位随机字符）
AFTERSALES_WEBHOOK_TOKEN="replace-with-random-webhook-token"
