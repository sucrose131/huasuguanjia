# 浏览器访问端口
APP_PORT=8080
TZ=Asia/Shanghai

# 外部 MySQL 连接。
# 若 MySQL 在 Docker 宿主机，主机名必须使用 host.docker.internal，不能使用 127.0.0.1。
# 数据库名必须为 hspsi-dev-ai-02，不得替换为历史数据库名称。
DATABASE_URL=mysql://root:CHANGE_ME@host.docker.internal:3306/hspsi-dev-ai-02

# 外部 Redis 8+ 连接。
# 若 Redis 在 Docker 宿主机，主机名必须使用 host.docker.internal，不能使用 127.0.0.1。
# 如需密码或指定 db，使用 redis://[:password@]host:port[/db] 格式。
REDIS_URL=redis://host.docker.internal:6379/10

# 必须在正式部署时替换，建议使用 openssl rand -hex 32 生成。
JWT_ACCESS_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ACCESS_TTL=45m
SESSION_TTL_SECONDS=604800
WEB_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
